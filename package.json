{
  "name": "yunkha-server",
  "version": "1.0.0",
  "private": true,
  "description": "Yunkha native WebSocket signaling backend built with NestJS",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-timeout=20000 test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-ws": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
